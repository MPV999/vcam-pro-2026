<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is disabled on purpose: media, keys and settings stay on the device. -->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="file"
        path="." />
</full-backup-content>
